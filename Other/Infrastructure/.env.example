# =============================================================================
# Application Template - Environment Variables Template
# Copy this file to .env or local.env and customize with your own values.
# DO NOT commit files containing actual secrets or production credentials.
# =============================================================================

# --- Server & Networking ---
GATEWAY_PORT=8080
GATEWAY_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:4200
OAUTH2_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- Internal Microservice URLs ---
CORE_SERVICE_URL=http://localhost:8081
MEDIA_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
UTILITY_SERVICE_URL=http://localhost:8085

# --- Security & JWT ---
# Generate a strong 256-bit secret key for production (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# --- Database Configurations (MySQL) ---
# Format: jdbc:mysql://<host>:<port>/<database>?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_URL_USER=jdbc:mysql://localhost:3306/app_users?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME_USER=auth_user
SPRING_DATASOURCE_PASSWORD_USER=auth_password

SPRING_DATASOURCE_URL_CORE=jdbc:mysql://localhost:3306/app_core?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME_CORE=core_user
SPRING_DATASOURCE_PASSWORD_CORE=core_password

SPRING_DATASOURCE_URL_MEDIA=jdbc:mysql://localhost:3306/app_media?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME_MEDIA=media_user
SPRING_DATASOURCE_PASSWORD_MEDIA=media_password

# --- Redis (Cache & Session) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# --- RabbitMQ / Message Broker ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_SSL_ENABLED=false

# --- Email Notifications (SMTP) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-app-password
APP_NOTIFICATION_EMAIL_FROM=noreply@example.com
APP_NOTIFICATION_SUPPORT_EMAIL=support@example.com

# --- Google OAuth2 (Optional - For Social Login) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Cloud Storage (Cloudinary / S3) ---
APP_STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- AI Integration (Optional) ---
AI_PROVIDER=huggingface
AI_API_BASE_URL=https://router.huggingface.co
AI_API_KEY=your_ai_api_key
AI_MODEL=meta-llama/Llama-3-8B-Instruct

# --- Monitoring & Tracing ---
MANAGEMENT_TRACING_ENABLED=false
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans
