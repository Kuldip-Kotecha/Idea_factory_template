<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>

 <parent>
 <groupId>org.springframework.boot</groupId>
 <artifactId>spring-boot-starter-parent</artifactId>
 <version>3.2.3</version>
 <relativePath/>
 </parent>

 <groupId>com.interviewcoach</groupId>
 <artifactId>utility-service</artifactId>
 <version>0.0.1-SNAPSHOT</version>
 <packaging>pom</packaging>
 <name>utility-service</name>
 <description>Utility Microservice for Interview Coach - Parent POM</description>

<modules>
  <module>parent</module>
  <module>tts</module>
  <module>scraping</module>
  <module>ai</module>
  </modules>

 <properties>
 <java.version>21</java.version>
 <skipTests>false</skipTests>
 </properties>

 <dependencyManagement>
 <dependencies>
 <dependency>
 <groupId>org.springframework.cloud</groupId>
 <artifactId>spring-cloud-dependencies</artifactId>
 <version>2023.0.0</version>
 <type>pom</type>
 <scope>import</scope>
 </dependency>
 </dependencies>
 </dependencyManagement>

<build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/integration/**/*.java</exclude>
            <exclude>**/smoke/**/*.java</exclude>
            <exclude>**/*IntegrationTest.java</exclude>
            <exclude>**/*SmokeTest.java</exclude>
            <exclude>**/*LiveTest.java</exclude>
          </excludes>
          <environmentVariables>
            <AI_API_KEY>${env.AI_API_KEY}</AI_API_KEY>
            <AI_MODEL>${env.AI_MODEL}</AI_MODEL>
          </environmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>create-source-zip</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <property name="src.zip" location="${project.build.directory}/utility-service-${project.version}-src.zip"/>
                <zip destfile="${src.zip}">
                  <zipfileset dir="${project.basedir}" prefix="utility-service" excludes="**/target/**"/>
                </zip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

<profiles>
  <profile>
  <id>smoke</id>
  <build>
  <plugins>
  <plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-failsafe-plugin</artifactId>
  <version>3.2.5</version>
  <configuration>
  <includes>
  <include>**/*SmokeTest.java</include>
  </includes>
  <environmentVariables>
  <AI_API_KEY>${env.AI_API_KEY}</AI_API_KEY>
  <AI_TTS_API_KEY>${env.AI_TTS_API_KEY}</AI_TTS_API_KEY>
  <AI_MODEL>${env.AI_MODEL}</AI_MODEL>
  </environmentVariables>
  </configuration>
  <executions>
  <execution>
  <goals>
  <goal>integration-test</goal>
  <goal>verify</goal>
  </goals>
  </execution>
  </executions>
  </plugin>
  </plugins>
  </build>
  </profile>
  <profile>
  <id>integration-test</id>
  <build>
  <plugins>
  <plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-failsafe-plugin</artifactId>
  <version>3.2.5</version>
  <configuration>
  <includes>
  <include>**/*IntegrationTest.java</include>
  </includes>
  <environmentVariables>
  <AI_API_KEY>${env.AI_API_KEY}</AI_API_KEY>
  <AI_TTS_API_KEY>${env.AI_TTS_API_KEY}</AI_TTS_API_KEY>
  <AI_MODEL>${env.AI_MODEL}</AI_MODEL>
  </environmentVariables>
  </configuration>
  <executions>
  <execution>
  <goals>
  <goal>integration-test</goal>
  <goal>verify</goal>
  </goals>
  </execution>
  </executions>
  </plugin>
  </plugins>
  </build>
  </profile>
  </profiles>
</project>
